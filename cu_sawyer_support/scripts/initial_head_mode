#!/usr/bin/env python3
"""Ensure Sawyer's head is in active cancellation mode with pan 0 after startup."""
import rospy
from intera_core_msgs.msg import HeadPanCommand, HeadState

def state_ok(state):
    return (state.panMode == HeadState.ACTIVE_CANCELLATION_MODE)

def main():
    rospy.init_node("initial_head_mode")
    pub = rospy.Publisher("/robot/head/command_head_pan", HeadPanCommand, queue_size=1)

    rospy.loginfo("Waiting for head state on /robot/head/head_state ...")
    state = rospy.wait_for_message("/robot/head/head_state", HeadState)

    latest = {"state": state}

    def cb(msg):
        latest["state"] = msg

    rospy.Subscriber("/robot/head/head_state", HeadState, cb, queue_size=1)

    cmd = HeadPanCommand()
    cmd.target = 0.0
    cmd.speed_ratio = 0.2
    cmd.pan_mode = HeadPanCommand.SET_ACTIVE_CANCELLATION_MODE

    start = rospy.Time.now()

    rate = rospy.Rate(1)
    while not rospy.is_shutdown() and not state_ok(latest["state"]):
        if (rospy.Time.now() - start).to_sec() > 20:
            rospy.logwarn_once("Still waiting for head to enter active cancellation mode.")
        pub.publish(cmd)
        rate.sleep()


    if not rospy.is_shutdown():
        rospy.loginfo("Head is in active cancellation mode.")


if __name__ == "__main__":
    main()
