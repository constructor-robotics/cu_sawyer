<?xml version="1.0"?>
<launch>
    <arg name="rviz" default="true"/>

    <node name="gripper_commander" pkg="cu_sawyer_support" type="gripper_commander"/>
    <node name="joint_trajectory_commander" pkg="intera_interface" type="joint_trajectory_action_server.py"/>
    <node name="screen_display_frame" pkg="tf2_ros" type="static_transform_publisher" args="0 0 0.002 0 0 0 1 screen screen_display"/>

    <node name="cu_img_publisher" pkg="image_publisher" type="image_publisher">
        <param name="filename" value="$(find cu_sawyer_bringup)/data/CU_Logo_RGB_Color_On_White.png"/>
        <remap from="cu_img_publisher/image_raw" to="/robot/head_display" />
    </node>

    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
        <rosparam param="source_list">[robot/joint_states]</rosparam>
        <param name="rate" value="100"/>
    </node>

    <include file="$(find cu_sawyer_moveit_config)/launch/move_group.launch"/>
    <node name="moveit_by_name" pkg="moveit_by_name" type="moveit_by_name"/>

    <node name="add_colliders_in_planning_scene" pkg="cu_sawyer_support" type="add_colliders_in_planning_scene"/>
    <node name="initial_head_mode" pkg="cu_sawyer_support" type="initial_head_mode"/>

    <include file="$(find tts_piper)/launch/tts_standalone.launch"/>

    <include if="$(arg rviz)" file="$(dirname)/rviz.launch"/>
</launch>
